.claude/*
!.claude/skills/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Env files (secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.production is OK to commit (only contains GENERATE_SOURCEMAP=false)

# SSH keys (deploy key for this VM)
.ssh/

# Market data (38GB, regeneratable from EODHD)
data/
# ...but site/ticker_pages/data/ is curated config (ticker list + sector
# map), not regeneratable runtime data — it MUST ship to every env.
!site/ticker_pages/data/
!site/ticker_pages/data/*.json

# data_updater downloaded samples (regeneratable)
data_updater/*.csv
data_updater/1/
data_updater/symbols_*.txt

# Generated runtime outputs
site/data/featured_chart.svg
site/data/featured_history.json
site/data/home_opportunities.csv

# Backup / patch leftovers
*.bak
*.orig
*.rej
*.work
*.1py

# Database dumps
*.sql
*.sql.gz
*.dump

# Compiled translation/locale files
*.mo
*.pot

# pyenv
.python-version

# pip
pip-log.txt
pip-delete-this-directory.txt

# Large media (host on CDN/object storage; reference by URL)
*.mp4
*.mov
*.webm
*.avi

# Appserver runtime caches
appserver/appserver/trend_chart_cache/

# SMN runtime artifacts (regenerated by article pipeline daily)
smn/article_ideas/
appserver/appserver/appserver.log*
smn/
