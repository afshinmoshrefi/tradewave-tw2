# PROD target coordinates. Same keys as target.env, prod values.
# Use for the prod build (Phase 0, placeholder tw2-prod.trxstat.com):
#   cp /home/flask/ops/staging/prod_target.env /home/flask/ops/staging/target.env
# then run the build-path scripts exactly as for staging. (Or export
# TGT_ENV_FILE=.../prod_target.env per invocation.)
#
# Web host stays the PLACEHOLDER tw2-prod.trxstat.com for the entire build +
# soak. The tradewave.ai flip is the separate cutover session (ops/PROD_CUTOVER.md);
# it is NOT done by these build scripts.

TGT_APP_PUB="${TGT_APP_PUB:-138.128.240.115}"
TGT_WEB_PUB="${TGT_WEB_PUB:-194.113.195.141}"
TGT_APP_VLAN="${TGT_APP_VLAN:-10.0.0.96}"
TGT_WEB_VLAN="${TGT_WEB_VLAN:-10.0.0.98}"
TGT_SSH_PORT="${TGT_SSH_PORT:-4369}"
TGT_WEB_HOST="${TGT_WEB_HOST:-tw2-prod.trxstat.com}"
TGT_APP_HOST="${TGT_APP_HOST:-tw2-prod-app.trxstat.com}"
TGT_SMN_HOST="${TGT_SMN_HOST:-smn.trxstat.com}"   # CONFIRM prod SMN host with Afshin before SMN steps
TGT_TUNNEL_WEB="${TGT_TUNNEL_WEB:-tw2-prod-web}"
TGT_TUNNEL_APP="${TGT_TUNNEL_APP:-tw2-prod-app}"
TGT_WEB_NGINX_SITE="${TGT_WEB_NGINX_SITE:-tw2-prod-web}"  # nginx sites-available filename (web tier)
TGT_APP_NGINX_SITE="${TGT_APP_NGINX_SITE:-tw2-prod-app}"  # nginx sites-available filename (app tier)
TGT_TW1_PROD_VLAN="${TGT_TW1_PROD_VLAN:-10.0.0.40}"

# --- TW1 prod source coordinates for the user/data migration (ops/migrate/*) ---
TGT_TW1_APP_VLAN="${TGT_TW1_APP_VLAN:-CONFIRM_tw1_prod_appserver_vlan_ip}"  # TW1 prod APPSERVER (redis db2 source) - for migrate_redis_from_tw1.sh
TGT_TW1_WP_HOST="${TGT_TW1_WP_HOST:-tradewave.ai}"          # TW1 WP vhost server_name (UMP api-gate Host header) - CONFIRM
TGT_TW1_WP_URL="${TGT_TW1_WP_URL:-http://localhost/}"        # WP base for the api-gate (export runs ON TW1 web -> localhost + Host above)
TGT_TW1_WP_CONFIG="${TGT_TW1_WP_CONFIG:-/var/www/html/wordpress/wp-config.php}"  # CONFIRM path on TW1 prod
TGT_TW1_KEYSTORE_URL="${TGT_TW1_KEYSTORE_URL:-http://localhost:7777}"  # TW1 keyprovider (key2 for api-gate) - CONFIRM if not local to TW1 web
TGT_TW1_PY="${TGT_TW1_PY:-python3}"                          # python on TW1 web that has 'requests' - CONFIRM (e.g. a venv path)
TGT_TW1_LEGACY_PRICE_MAP="${TGT_TW1_LEGACY_PRICE_MAP:-}"     # optional path (on TW2 web) to legacy_price_map.json
