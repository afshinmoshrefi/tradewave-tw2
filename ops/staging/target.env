# Target environment coordinates for the ops/staging/*.sh build playbook.
# Sourced by every build-path script. Defaults = STAGING (so staging behaviour
# is byte-identical and idempotent). To build PROD, source prod_target.env
# instead (same keys, prod values) before running a script, e.g.:
#
#   TGT_ENV_FILE=/home/flask/ops/staging/prod_target.env \
#     /home/flask/ops/staging/bootstrap_stage_app.sh
#
# or simply: cp prod_target.env target.env  on the orchestration box for a
# full prod run. Every script does:  . "${TGT_ENV_FILE:-<dir>/target.env}"
#
# Each value is ${VAR:-default} so an inline env override still wins.

TGT_APP_PUB="${TGT_APP_PUB:-199.244.48.157}"      # app box public IP
TGT_WEB_PUB="${TGT_WEB_PUB:-185.53.209.8}"        # web box public IP
TGT_APP_VLAN="${TGT_APP_VLAN:-10.0.0.92}"         # app box Kamatera VLAN IP
TGT_WEB_VLAN="${TGT_WEB_VLAN:-10.0.0.94}"         # web box Kamatera VLAN IP
TGT_SSH_PORT="${TGT_SSH_PORT:-4369}"              # ssh port (all boxes)
TGT_WEB_HOST="${TGT_WEB_HOST:-tw2-stage.trxstat.com}"       # public web hostname (live staging)
TGT_APP_HOST="${TGT_APP_HOST:-tw2-stage-app.trxstat.com}"   # public appserver hostname
TGT_SMN_HOST="${TGT_SMN_HOST:-smn-stage.trxstat.com}"       # public SMN hostname
TGT_API_HOST="${TGT_API_HOST:-api-stage.trxstat.com}"
TGT_MCP_HOST="${TGT_MCP_HOST:-mcp-stage.trxstat.com}"
TGT_DEVELOPERS_HOST="${TGT_DEVELOPERS_HOST:-developers-stage.trxstat.com}"
TGT_TUNNEL_WEB="${TGT_TUNNEL_WEB:-tw2-stage-web}"  # cloudflared tunnel name (web)
TGT_TUNNEL_APP="${TGT_TUNNEL_APP:-tw2-stage-app}"  # cloudflared tunnel name (app)
TGT_WEB_NGINX_SITE="${TGT_WEB_NGINX_SITE:-tw2-stage-web}"  # nginx sites-available filename (web tier)
TGT_APP_NGINX_SITE="${TGT_APP_NGINX_SITE:-tw2-stage-app}"  # nginx sites-available filename (app tier)
TGT_APP_WORKERS="${TGT_APP_WORKERS:-4}"            # post-resize 4 CPU staging topology
TGT_APP_THREADS="${TGT_APP_THREADS:-4}"
TGT_TW1_PROD_VLAN="${TGT_TW1_PROD_VLAN:-10.0.0.40}"  # live TW1 prod web (rsync source)

# --- TW1 prod source coordinates for the user/data migration (ops/migrate/*) ---
# (TW1 PROD is the source even for a staging-targeted run, same as TGT_TW1_PROD_VLAN above.)
TGT_TW1_APP_VLAN="${TGT_TW1_APP_VLAN:-CONFIRM_tw1_prod_appserver_vlan_ip}"  # TW1 prod APPSERVER (redis db2 source) - for migrate_redis_from_tw1.sh
TGT_TW1_WP_HOST="${TGT_TW1_WP_HOST:-tradewave.ai}"          # TW1 WP vhost server_name (UMP api-gate Host header) - CONFIRM
TGT_TW1_WP_URL="${TGT_TW1_WP_URL:-http://localhost/}"        # WP base for the api-gate (export runs ON TW1 web -> localhost + Host above)
TGT_TW1_WP_CONFIG="${TGT_TW1_WP_CONFIG:-/var/www/html/wordpress/wp-config.php}"  # CONFIRM path on TW1 prod
TGT_TW1_KEYSTORE_URL="${TGT_TW1_KEYSTORE_URL:-http://localhost:7777}"  # TW1 keyprovider (key2 for api-gate) - CONFIRM if not local to TW1 web
TGT_TW1_PY="${TGT_TW1_PY:-python3}"                          # python on TW1 web that has 'requests' - CONFIRM (e.g. a venv path)
TGT_TW1_LEGACY_PRICE_MAP="${TGT_TW1_LEGACY_PRICE_MAP:-}"     # optional path (on TW2 web) to legacy_price_map.json
