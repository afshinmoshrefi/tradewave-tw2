[Unit]
Description=TradeWave API gateway (gunicorn)
After=network.target redis-server.service

[Service]
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
Type=notify
User=flask
Group=flask
WorkingDirectory=/home/flask
# Bind defaults to loopback (gateway co-located on the app box = the launch topology). To run
# the gateway on its OWN box later, set TW2_APISERVER_BIND in secrets.env to the box's reachable
# VLAN address (e.g. 10.0.0.x:8088). This default is placed BEFORE EnvironmentFile so a value in
# secrets.env overrides it. See ops/SPLIT_GATEWAY_TO_OWN_BOX.md.
Environment=TW2_APISERVER_BIND=127.0.0.1:8088
EnvironmentFile=/etc/tradewave/secrets.env
Environment=PYTHONPATH=/home/flask
# gthread (4 workers x 12 threads = 48 concurrent requests): the gateway is I/O-bound
# (it waits on the appserver), so sync workers serialize the box to 4 in-flight requests
# and one busy tenant's scan storm queues everyone else's 60ms /v1/me into the 30s range.
ExecStart=/home/flask/venv-api/bin/gunicorn --workers 4 --worker-class gthread --threads 12 --timeout 120 --keep-alive 75 \
    --bind ${TW2_APISERVER_BIND} --access-logfile /var/log/tradewave/apiserver.access.log \
    --access-logformat '%({x-forwarded-for}i)s %(l)s %(u)s %(t)s "%(m)s %(U)s %(H)s" %(s)s %(b)s "%(a)s"' \
    --error-logfile /var/log/tradewave/apiserver.error.log --capture-output apiserver.app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
